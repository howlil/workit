{
  "name": "workit",
  "version": "0.1.0",
  "description": "Personal job-search memory, context tracker, and smart autofill workflow system",
  "private": true,
  "type": "module",
  "author": "howlil",
  "license": "MIT",
  "homepage": "https://github.com/howlil/workit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/howlil/workit.git"
  },
  "bugs": {
    "url": "https://github.com/howlil/workit/issues"
  },
  "keywords": [
    "job-search",
    "browser-extension",
    "autofill",
    "application-tracking",
    "mcp",
    "cloudflare-workers",
    "d1",
    "ai-assistant"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @workit/extension test:e2e",
    "lint": "pnpm -r --parallel lint"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
